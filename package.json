{
  "private": true,
  "name": "keybr-local",
  "version": "0.0.0",
  "type": "module",
  "homepage": ".",
  "license": "AGPL-3.0-only",
  "author": "Aliaksandr Radzivanovich <aradzivanovich@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "bun run check:workspaces && NODE_ENV=production webpack",
    "build:dev": "bun run check:workspaces && NODE_ENV=development webpack",
    "dev": "bun run check:workspaces && NODE_ENV=development webpack --watch",
    "serve": "bun ./scripts/serve.ts",
    "start": "bun run build && bun run serve",
    "check:workspaces": "bun ./scripts/check-workspaces.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "clsx": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intl": "^10.1.0"
  },
  "devDependencies": {
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "less": "^4.6.4",
    "less-loader": "^12.3.2",
    "mini-css-extract-plugin": "^2.10.1",
    "terser-webpack-plugin": "^5.4.0",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.2"
  },
  "description": "A local-only, frontend-only adaptive typing trainer derived from keybr.com.",
  "packageManager": "bun@1.2.20",
  "engines": {
    "bun": ">=1.2.20"
  }
}
