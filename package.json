{
  "name": "samey-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs site",
    "typecheck": "node node_modules/typescript-7/bin/tsc -b tsconfig.json --pretty false",
    "build": "bun build.ts",
    "build:wordle": "bun build.ts wordle",
    "build:keybr": "bun build.ts keybr",
    "build:afterimage": "bun build.ts afterimage",
    "build:site": "bun build.ts site",
    "dev:wordle": "node scripts/dev.mjs wordle",
    "dev:keybr": "node scripts/dev.mjs keybr",
    "dev:afterimage": "node scripts/dev.mjs afterimage",
    "import:keybr-books": "bun scripts/import-keybr-books.mjs",
    "check:keybr-corpus": "bun scripts/check-keybr-corpus.mjs",
    "check:afterimage-build": "node scripts/verify-afterimage-build.mjs",
    "lint": "eslint src --max-warnings 0",
    "test": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test:chain && bun run test:afterimage && bun run test:tools && bun run test:keybr && bun run test:projects && bun run test:transitions && bun run build && bun run check:afterimage-build && bun run test",
    "test:afterimage": "bun test ./tests/afterimage-*.test.ts ./src/games/afterimage/words.test.mjs",
    "test:chain": "bun test tests/chain-bot-core.test.ts",
    "test:tools": "bun test ./tests/tools-*.test.ts",
    "test:keybr": "bun test ./tests/keybr-*.test.ts",
    "test:projects": "node --test tests/project-engines.test.mjs && bun test tests/project-engine-runner.test.ts",
    "test:transitions": "bun test tests/after-visual-transition.test.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@kobalte/core": "2.0.0-alpha.2",
    "@solidjs/web": "2.0.0-rc.13",
    "clsx": "2.1.1",
    "idb": "^8.0.3",
    "lucide": "1.50.0",
    "monaco-editor": "0.57.0",
    "onnxruntime-web": "1.30.0",
    "solid-js": "2.0.0-rc.13",
    "vditor": "^4.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "solid-js": "2.0.0-rc.13",
    "@solidjs/web": "2.0.0-rc.13",
    "@solidjs/signals": "2.0.0-rc.13",
    "brace-expansion": "5.0.12",
    "dompurify": "3.4.16"
  }
}
